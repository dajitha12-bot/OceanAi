# Django Security Configuration
DJANGO_SECRET_KEY=django-insecure-ocean-intelligence-secret-key-12345
DEBUG=True

# Database Configuration URL (PostgreSQL + PostGIS)
# Scheme MUST be postgis:// for spatial features.
# Format: postgis://username:password@host:port/database_name
DATABASE_URL=postgis://postgres:postgres@localhost:5432/ocean_intelligence

# Data Mode Configuration
# Set to 'True' to run entirely offline on local CSV/JSON demo datasets
# Set to 'False' to fetch live data from Copernicus & OBIS APIs
DEMO_MODE=True

# External API Credentials: Copernicus Marine
COPERNICUS_USERNAME=your_copernicus_username_here
COPERNICUS_PASSWORD=your_copernicus_password_here

# Generative AI & RAG Configuration
# Provider options: gemini or openai
LLM_PROVIDER=gemini
LLM_API_KEY=your_google_gemini_api_key_here
LLM_MODEL=gemini-1.5-flash
